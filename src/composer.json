{
    "name": "processmaker/docker-executor-php-runtime",
    "description": "Runtime dependencies for the ProcessMaker PHP script executor",
    "license": "AGPL-3.0-or-later",
    "require": {
        "aws/aws-sdk-php": "^3.192,<3.368",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "mockery/mockery": "^1.2"
    },
    "autoload": {
        "psr-4": {"Executor\\": "."}
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
